# The API's own database. cars-secrets-data-ingest's worker fills `public.lots` (active lots,
# read-only here); accounts live in the `app` schema, migrated by this repo
# (`uv run alembic upgrade head`). Locally the ingest's `api-db` container, password
# API_POSTGRES_PASSWORD from the ingest's .env; hosted: add ?sslmode=require.
DATABASE_URL=postgresql://api:change-me@localhost:5434/api

# Public origin of the web app: links in emails and OAuth redirect URIs.
WEB_URL=http://localhost:3000
# Shared with the web server; lets the API trust X-Client-IP for rate limiting. 32+ random chars.
INTERNAL_API_KEY=

# HMAC key for stored email confirmation codes, and the key of the email waiting to be sent.
# 32+ random chars. Empty = a random key per process (development only: codes and unsent email
# die on restart and are not shared between workers).
EMAIL_CODE_SECRET=

# Cloudflare Turnstile secret. Empty = captcha not enforced.
TURNSTILE_SECRET=
# Reject passwords found in Have I Been Pwned (k-anonymity lookup).
CHECK_BREACHED_PASSWORDS=true

# How often the alert job (reminders, saved-lot changes, search summaries) runs in the API
# process, in seconds. 0 = never.
ALERTS_INTERVAL_SECONDS=60

# Outgoing mail, through any SMTP provider (README: Sending email in production). Empty
# SMTP_HOST = messages (with their links) go to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=CarBidInsight <no-reply@localhost>

# Social login. A provider is offered only when all of its variables are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
